# ---- Database -------------------------------------------------------------
# SQLite (zero-setup fallback — works with no Postgres installed):
# DATABASE_URL=sqlite:///./dev.db
#
# PostgreSQL (recommended):
#   Local:  postgresql+psycopg://tripopt:tripopt@localhost:5432/tripopt
#   Cloud:  postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://tripopt:tripopt@localhost:5432/tripopt

# ---- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- External API keys (optional — agents degrade gracefully without them) ----
GOOGLE_PLACES_API_KEY=
OPENWEATHERMAP_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
OPENAI_API_KEY=

# ---- Destination photos (both optional) ----
# With neither key set, the resolver falls back to Openverse, which needs no
# key. Setting one of these gives better-quality, correctly-sized images.
#   Unsplash: https://unsplash.com/developers  (free, 50 req/hour demo tier)
#   Pexels:   https://www.pexels.com/api/      (free, 200 req/hour)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
